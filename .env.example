# Copy to .env.local and fill in your real values. Never commit secrets.
# .env.local is git-ignored; the SAME values must be set as env vars in
# Lovable Cloud for the deployed site (Settings > Environment Variables).

# --- Server-only secrets (never VITE_-prefixed, never sent to the browser) ---
LASTFM_API_KEY=your-last-fm-api-key
MUSICBRAINZ_ACCESS_TOKEN=your-musicbrainz-access-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MUSICBRAINZ_USER_AGENT=SONGBOARD/1.0 (your-site.example)

# --- Public Supabase (keep in sync with your project) ---
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
